{
  "name": "champions-api-node",
  "version": "1.0.0",
  "description": "API REST da Champions League com Node.js, Express e TypeScript em camadas: desafio de projeto da DIO.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start:dev": "tsx --env-file-if-exists=.env src/server.ts",
    "start:watch": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "dist": "tsup",
    "start:dist": "npm run dist && node --env-file-if-exists=.env dist/server.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.9"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "rest-api",
    "dio",
    "champions-league"
  ],
  "author": "raabesmps",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
